{
  "name": "eql-atlas-cross-platform",
  "productName": "EQL Atlas Cross-Platform",
  "version": "0.1.0",
  "private": true,
  "description": "Offline 3D viewer for local EverQuest map files",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.js",
    "test:maps": "node scripts/check-maps.mjs",
    "test:desktop": "npm run build && electron . --self-test",
    "test:browser": "npm run build && electron . --browser-test",
    "test:regressions": "npm run build && electron . --regression-test && electron . --regression-test --browser-test",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.3.0",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
